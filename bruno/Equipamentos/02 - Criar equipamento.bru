meta {
  name: Criar equipamento
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/equipamentos
  body: json
  auth: inherit
}

body:json {
  {
    "nome_equipamento": "Equipamento Teste {{$timestamp}}",
    "componentes": [
      {{componenteArmazenamentoId}},
      {{componenteProcessamentoId}},
      {{componenteDisplayId}}
    ]
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.dados && body.dados.id_equipamento) {
    bru.setEnvVar("equipamentoId", body.dados.id_equipamento);
  }
}

tests {
  test("deve criar o equipamento com armazenamento e processamento", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
