meta {
  name: Buscar componente por ID
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/componentes/{{componenteId}}
  body: none
  auth: inherit
}

tests {
  test("deve retornar o componente", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().dados.codigo_componente).to.equal(Number(bru.getEnvVar("componenteId")));
  });
}
