meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usuario": "admin",
    "senha": "admin123"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.token) {
    bru.setEnvVar("token", body.token);
  }
}

tests {
  test("deve retornar 200 e um token JWT", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().token).to.be.a("string");
  });
}

docs {
  Realiza login com usuário e senha e salva o token JWT na variável de ambiente "token".
  Usuário padrão criado pelo setup: admin / admin123.
}
