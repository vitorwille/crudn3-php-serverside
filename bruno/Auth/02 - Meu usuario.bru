meta {
  name: Meu usuário
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: inherit
}

tests {
  test("deve retornar o usuário autenticado", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().dados.nome_usuario).to.be.a("string");
  });
}
