  auth: inherit
}

body:json {
  {
    "nome_equipamento": "Equipamento sem componentes {{$timestamp}}",
    "componentes": []
  }
}

tests {
  test("deve retornar 422", function() {
    expect(res.getStatus()).to.equal(422);
  });
}
