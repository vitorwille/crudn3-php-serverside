meta {
  name: Equipamento sem processamento deve falhar
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/equipamentos
  body: json
  auth: inherit
}

body:json {
  {
    "nome_equipamento": "Equipamento Inválido {{$timestamp}}",
    "componentes": [
      {{componenteArmazenamentoId}},
      {{componenteDisplayId}}
    ]
  }
}

tests {
  test("deve retornar 422", function() {
    expect(res.getStatus()).to.equal(422);
  });
}
